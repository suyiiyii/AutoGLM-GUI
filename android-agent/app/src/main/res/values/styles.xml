<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AgentFilledCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPaddingStart">24dp</item>
        <item name="contentPaddingEnd">24dp</item>
        <item name="contentPaddingTop">20dp</item>
        <item name="contentPaddingBottom">20dp</item>
        <item name="cardBackgroundColor">?colorSecondaryContainer</item>
    </style>

    <style name="AgentTertiaryFilledCard" parent="@style/AgentFilledCard">
        <item name="cardBackgroundColor">?colorTertiaryContainer</item>
    </style>

    <style name="AgentErrorFilledCard" parent="@style/AgentFilledCard">
        <item name="cardBackgroundColor">?colorErrorContainer</item>
    </style>

    <style name="AgentSurfaceFilledCard" parent="@style/AgentFilledCard">
        <item name="cardBackgroundColor">?colorSurfaceContainerHigh</item>
    </style>

    <style name="AgentMiniCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPaddingStart">20dp</item>
        <item name="contentPaddingEnd">20dp</item>
        <item name="contentPaddingTop">20dp</item>
        <item name="contentPaddingBottom">20dp</item>
        <item name="cardBackgroundColor">?colorSurfaceContainerHighest</item>
    </style>

    <style name="AgentIconCircleCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">?colorPrimaryContainer</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:textAppearance">?textAppearanceTitleLarge</item>
        <item name="android:textColor">?colorOnSecondaryContainer</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardSummary">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:textColor">?colorOnSecondaryContainer</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="SectionOverline">
        <item name="android:textAppearance">?textAppearanceLabelLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
</resources>
