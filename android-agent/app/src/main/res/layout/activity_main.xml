<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/transparent"
            android:elevation="0dp"
            android:paddingHorizontal="4dp"
            app:subtitle="@string/app_summary"
            app:title="@string/app_name"
            app:titleCentered="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="40dp"
                app:cardElevation="2dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hero_gradient"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_primary"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="@string/setup_intro_overline"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="@color/agent_on_primary_container"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/setup_intro_label"
                        android:textAppearance="?textAppearanceDisplaySmall"
                        android:textColor="@color/agent_on_primary_container"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/setup_intro_body"
                        android:textAppearance="?textAppearanceBodyLarge"
                        android:textColor="@color/agent_on_primary_container" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/tonal_tile_primary"
                            android:gravity="center_vertical"
                            android:minHeight="84dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:text="@string/setup_intro_badge_steps"
                            android:textAppearance="?textAppearanceTitleSmall"
                            android:textColor="@color/agent_on_primary_container"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/tonal_tile_secondary"
                            android:gravity="center_vertical"
                            android:minHeight="84dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:text="@string/setup_intro_badge_recovery"
                            android:textAppearance="?textAppearanceTitleSmall"
                            android:textColor="@color/agent_on_secondary_container"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/tonal_tile_tertiary"
                        android:gravity="center_vertical"
                        android:minHeight="72dp"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="14dp"
                        android:text="@string/setup_intro_badge_reverse"
                        android:textAppearance="?textAppearanceTitleSmall"
                        android:textColor="@color/agent_on_tertiary_container"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?colorSurface"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                app:strokeColor="?colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_section_label"
                        android:textAppearance="?textAppearanceHeadlineSmall"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/setupSummaryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/setup_summary_default"
                        android:textAppearance="?textAppearanceBodyLarge"
                        android:textColor="?colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/setupChecklistStep1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/checklist_step_bg"
                            android:minHeight="76dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="16dp"
                            android:text="@string/setup_step_agent_pending"
                            android:textAppearance="?textAppearanceTitleMedium"
                            android:textColor="?colorOnSurface" />

                        <TextView
                            android:id="@+id/setupChecklistStep2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/checklist_step_bg"
                            android:minHeight="76dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="16dp"
                            android:text="@string/setup_step_accessibility_pending"
                            android:textAppearance="?textAppearanceTitleMedium"
                            android:textColor="?colorOnSurface" />

                        <TextView
                            android:id="@+id/setupChecklistStep3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/checklist_step_bg"
                            android:minHeight="76dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="16dp"
                            android:text="@string/setup_step_capture_pending"
                            android:textAppearance="?textAppearanceTitleMedium"
                            android:textColor="?colorOnSurface" />

                        <TextView
                            android:id="@+id/setupChecklistStep4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/checklist_step_bg"
                            android:minHeight="76dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="16dp"
                            android:text="@string/setup_step_reverse_pending"
                            android:textAppearance="?textAppearanceTitleMedium"
                            android:textColor="?colorOnSurface" />

                        <TextView
                            android:id="@+id/setupChecklistStep5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/checklist_step_bg"
                            android:minHeight="76dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="16dp"
                            android:text="@string/setup_step_validation_pending"
                            android:textAppearance="?textAppearanceTitleMedium"
                            android:textColor="?colorOnSurface" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/setupPrimaryButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/setup_action_start_agent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/runValidationButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/setup_action_run_validation" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/panel_error"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_primary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/section_badge_support"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="@color/agent_on_error_container"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recoveryTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/recovery_section_label"
                        android:textAppearance="?textAppearanceTitleLarge"
                        android:textColor="@color/agent_on_error_container"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recoveryMessageText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/recovery_default"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:textColor="@color/agent_on_error_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recoveryActionButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/recovery_action_default" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/panel_secondary"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_primary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/section_badge_pairing"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="@color/agent_on_secondary_container"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/reverse_agent_section_label"
                        android:textAppearance="?textAppearanceTitleLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/reverse_pairing_section_summary"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:textColor="?colorOnSurfaceVariant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="@string/reverse_server_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/reverseServerInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/reverse_pairing_code_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pairingCodeInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pairButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/reverse_pair_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearPairingButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/reverse_clear_pairing_button" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/reverse_agent_status_label"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/reverseAgentStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/reverse_status_unpaired"
                        android:textAppearance="?textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/reverseAgentDetailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/reverse_agent_detail_placeholder"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:textColor="?colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?colorSurface"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                app:strokeColor="?colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_secondary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/section_badge_support"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="?colorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/technical_state_section_label"
                        android:textAppearance="?textAppearanceTitleLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/technical_state_section_summary"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/server_status_label"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/server_endpoint_label"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/endpointText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?textAppearanceBodyLarge" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/accessibility_status_label"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/accessibilityStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?textAppearanceBodyLarge" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/capture_status_label"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/captureStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?textAppearanceBodyLarge" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/startButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/start_server" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stopButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/stop_server" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/accessibilityButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/open_accessibility_settings" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/captureButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/request_screen_capture" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/panel_tertiary"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_primary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/section_badge_demo"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="@color/agent_on_tertiary_container"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/local_demo_section_label"
                        android:textAppearance="?textAppearanceTitleLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/local_demo_section_summary"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:textColor="?colorOnSurfaceVariant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="@string/demo_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/demoInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tapTargetButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/tap_target_label" />

                    <TextView
                        android:id="@+id/demoStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/demo_status_idle"
                        android:textAppearance="?textAppearanceBodyLarge" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/swipe_area_label"
                        android:textAppearance="?textAppearanceLabelLarge"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="600dp"
                        android:background="@drawable/checklist_step_bg"
                        android:padding="18dp"
                        android:text="@string/scroll_content"
                        android:textAppearance="?textAppearanceBodyMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
